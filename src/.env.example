APP_NAME="Nutrition-Rag-App"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES= # ["text/plain","application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000  # 512KB

# ========================= Auth Config =========================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change-this-to-a-random-secret-at-least-32-chars"

# Comma-separated allowed origins, or * for development
ALLOWED_ORIGINS="*"

# ========================= PostgresDB Config =========================
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="your_db_password_here"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="hearthwise"

# ========================= LLM Config =========================
# Choose backend: COHERE or OPENAI
GENERATION_BACKEND="COHERE"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""

GENERATION_MODEL_ID="command-a-03-2025"
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"
EMBEDDING_MODEL_SIZE=1024

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
# Choose backend: PGVECTOR or QDRANT
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=

# ========================= Template Configs =========================
PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ========================= Email (OTP) =========================
# Leave SMTP_HOST empty in dev: verification codes are printed in the backend log.
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USERNAME=<you@gmail.com>, SMTP_PASSWORD=<app password>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
