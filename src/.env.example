APP_NAME="Nutrition-Rag-App"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES='["text/plain","application/pdf"]'
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000  # 512KB

# ========================= Auth Config =========================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change-this-to-a-random-secret-at-least-32-chars"

# Comma-separated allowed origins, or * for development
ALLOWED_ORIGINS="*"

# ========================= PostgresDB Config =========================
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="your_db_password_here"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="hearthwise"

# ========================= LLM Config =========================
# Choose backend: OPENROUTER (default), OPENAI or COHERE
GENERATION_BACKEND="OPENROUTER"
EMBEDDING_BACKEND="OPENROUTER"

# Key from https://openrouter.ai/keys
# Production: use the project's own OpenRouter key, named "NutriAI" in OpenRouter (credit limit set).
# Put it in src/.env on the server, which git ignores. Never commit the key.
OPENROUTER_API_KEY=""
# Any chat model id from https://openrouter.ai/models
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Embedding model (an id from https://openrouter.ai/api/v1/embeddings/models when EMBEDDING_BACKEND is OPENROUTER).
# EMBEDDING_MODEL_SIZE must match the model; changing either means re-indexing your documents.
EMBEDDING_MODEL_ID="openai/text-embedding-3-small"
EMBEDDING_MODEL_SIZE=1536

# Only used if a backend above is set to OPENAI or COHERE, but must stay in the file (empty is fine)
OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""
GENERATION_MODEL_ID=""
GENERATION_MODEL_ID_LITERAL='[]'

# AI answers (chat + demo chat) per signed-in user, or per IP when signed out, per UTC day
AI_DAILY_LIMIT=5

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
# Choose backend: PGVECTOR or QDRANT
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_BACKEND_LITERAL='["PGVECTOR","QDRANT"]'
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# ========================= Template Configs =========================
PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ========================= Email (OTP) =========================
# Leave SMTP_HOST empty in dev: verification codes are printed in the backend log.
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USERNAME=<you@gmail.com>, SMTP_PASSWORD=<app password>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
